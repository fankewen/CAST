# Copy via tools/init_env.py, which generates independent random credentials.
# Never commit .env or real keys. Environment variables override these values.
CAST_HOST=127.0.0.1
CAST_PORT=8080
CAST_GPU=0
CAST_BACKBONE=dinov3
CAST_STATE_DIR=var
CAST_ASSETS_DIR=assets
CAST_API_KEY=
CAST_ADMIN_USER=admin
CAST_ADMIN_PASSWORD=
CAST_ADMIN_HOST=127.0.0.1
CAST_ADMIN_PORT=8081
# Set a LOCAL disk directory if CAST_STATE_DIR is on a network filesystem.
CAST_ADMIN_STATE_DIR=var/admin/local
CAST_ADMIN_SECURE_COOKIE=0
CAST_PIPELINE_CAPACITY=10
CAST_HTTP_ACTIVE_LIMIT=64
CAST_HTTP_TCP_LIMIT=256
CAST_FULL_STEP_GRAPH=1
# Images/motion are sensitive. Enable only with appropriate notice/consent.
CAST_HISTORY_ENABLED=0
CAST_HISTORY_INTERVAL_SECONDS=1
CAST_HISTORY_RETENTION_SECONDS=86400
CAST_HISTORY_MAX_SAMPLES=3600
CAST_HISTORY_MAX_BYTES=2147483648
